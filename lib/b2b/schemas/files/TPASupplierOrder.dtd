<!--
  TPA-SupplierOrder 1.0 (design.md P9, SWHR-R-0035). ShippingAddress
  carries nine flat fields, in order; at least one LineItem is required,
  with no wrapping element. DTD validation itself is unavailable under
  Bun (SD-2) — see TPASupplierOrder.dtd.xsd for the equivalent used to
  validate a document declaring this type.
-->
<!ENTITY % TPALineItem SYSTEM "TPALineItem.dtd">
%TPALineItem;

<!ELEMENT SupplierOrder (OrderId, OrderDate, ShippingAddress, LineItem+)>
<!ELEMENT OrderId (#PCDATA)>
<!ELEMENT OrderDate (#PCDATA)>
<!ELEMENT ShippingAddress (FirstName, LastName, Street, City, State, Country, ZipCode, Email, Phone)>
<!ELEMENT FirstName (#PCDATA)>
<!ELEMENT LastName (#PCDATA)>
<!ELEMENT Street (#PCDATA)>
<!ELEMENT City (#PCDATA)>
<!ELEMENT State (#PCDATA)>
<!ELEMENT Country (#PCDATA)>
<!ELEMENT ZipCode (#PCDATA)>
<!ELEMENT Email (#PCDATA)>
<!ELEMENT Phone (#PCDATA)>
