<?xml version="1.0" encoding="UTF-8"?>
<!--
  DTD-equivalent XSD for ContactInfo.dtd (design.md P1/SD-2). Includes
  Address.dtd.xsd for the embedded Address element, the same modularization
  ContactInfo.dtd uses via a parameter entity.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:include schemaLocation="Address.dtd.xsd"/>

  <xs:element name="ContactInfo">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="FamilyName" type="xs:string"/>
        <xs:element name="GivenName" type="xs:string"/>
        <xs:element ref="Address"/>
        <xs:element name="Email" type="xs:string"/>
        <xs:element name="Phone" type="xs:string"/>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
