<?xml version="1.0" encoding="UTF-8"?>
<!-- DTD-equivalent XSD for OrderApproval.dtd (design.md P2). -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:element name="OrderApproval">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="Order" minOccurs="1" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="OrderId" type="xs:string"/>
              <xs:element name="OrderStatus" type="xs:string"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
  </xs:element>
</xs:schema>
